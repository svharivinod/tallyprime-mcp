# URL where TallyPrime Gateway Server is running
# Local: http://localhost:9000
# With Cloudflare tunnel: https://your-name.trycloudflare.com
TALLY_URL=http://localhost:9000

# Timeout in seconds for Tally XML requests
TALLY_TIMEOUT=30

# --- Cloud/SSE mode only (not needed for Claude Desktop) ---
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Bearer token to protect your cloud endpoint (leave blank to disable auth)
MCP_API_KEY=
